	.rlibrary.bkd0.border.frame.fsbox.lf.pane.1.dirlist.vsb configure -activebackground [.rlibrary.bkd0.border.frame.fsbox.lf.pane.1.dirlist.vsb cget -background]
    }
    .rlibrary.bkd0.border.frame.fsbox.lf.pane.1.dirlist.vsb activate [.rlibrary.bkd0.border.frame.fsbox.lf.pane.1.dirlist.vsb identify 7 77]
     if {$tk_strictMotif && [info exists tk::Priv(activeBg)]} {
	.rlibrary.bkd0.border.frame.fsbox.lf.pane.1.dirlist.vsb configure -activebackground $tk::Priv(activeBg)
    }
    .rlibrary.bkd0.border.frame.fsbox.lf.pane.1.dirlist.vsb activate {}
     tk::ButtonEnter .rlibrary.bkd0.border.frame.fsbox.lf.pane.2.file.frame.arrow
     tk::ButtonLeave .rlibrary.bkd0.border.frame.fsbox.lf.pane.2.file.frame.arrow
     tk::ButtonEnter .rlibrary.bkd0.border.frame.fsbox.bf.ok
     tk::ButtonLeave .rlibrary.bkd0.border.frame.fsbox.bf.ok
     tk::ButtonEnter .rlibrary.bt.help
     tk::ButtonLeave .rlibrary.bt.help
         if { [ .v_menu.logo cget -state ] == "normal" } {
            .v_menu.logo configure -relief groove
        }
    
     tk::ButtonEnter .v_menu.logo
 .v_menu.logo configure -relief flat 
     tk::ButtonLeave .v_menu.logo
     tk::ButtonEnter .icon.setup
     tk::ButtonLeave .icon.setup
callback Gui_hlist_leave .a.pane.f1.middle.revised.fm.tree.f1.hlist
